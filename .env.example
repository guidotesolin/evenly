# Supabase project (local: printed by `npx supabase start`). The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth Web client ID, used by Google Sign-In to issue the ID token (T2)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Only for tools/excel-import.ts (T7). Never in the app, never committed.
SUPABASE_SERVICE_ROLE_KEY=
